---
import type { CollectionEntry } from "astro:content";

import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

type Props = {
  course: CollectionEntry<"courses">;
  description: string;
  eyebrow: string;
  title: string;
};

const { course, description, eyebrow, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      description={description}
      title={`${title} | ${course.data.title}`}
    />
  </head>
  <body class="grain-overlay">
    <Header />

    <main class="reference-main">
      <header class="reference-hero">
        <div class="container-narrow">
          <a class="breadcrumb" href={`/lessons/${course.data.slug}/`}>
            <svg
              aria-hidden="true"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            {course.data.title}
          </a>
          <p class="reference-eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="reference-description">{description}</p>
        </div>
      </header>

      <article class="reference-article">
        <div class="container-narrow reference-body">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .reference-main {
    padding-top: 80px;
  }

  .reference-hero {
    padding: var(--space-12) 0 var(--space-16);
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(37, 99, 235, 0.12),
        transparent 35%
      ),
      var(--color-bg-primary);
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .breadcrumb:hover {
    color: var(--accent-dark);
  }

  .reference-eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reference-hero h1 {
    max-width: 820px;
    margin-bottom: var(--space-5);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  @media (min-width: 768px) {
    .reference-hero h1 {
      font-size: var(--text-6xl);
    }
  }

  .reference-description {
    max-width: 760px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-xl);
    line-height: 1.7;
  }

  .reference-article {
    padding: var(--space-16) 0;
    background: var(--color-bg-primary);
  }

  .reference-body {
    max-width: 900px;
  }

  .reference-body :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    scroll-margin-top: 100px;
  }

  .reference-body :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    scroll-margin-top: 100px;
  }

  .reference-body :global(p),
  .reference-body :global(li),
  .reference-body :global(dd) {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .reference-body :global(p) {
    margin-bottom: var(--space-6);
  }

  .reference-body :global(ul) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .reference-body :global(li) {
    margin-bottom: var(--space-3);
  }

  .reference-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reference-body :global(a:hover) {
    color: var(--accent-dark);
  }

  .reference-body :global(strong) {
    color: var(--color-text-primary);
  }

  .reference-body :global(code) {
    font-family: var(--font-mono);
  }

  .reference-body :global(.reference-note) {
    margin: var(--space-8) 0;
    padding: var(--space-5) var(--space-6);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: var(--color-bg-secondary);
  }

  .reference-body :global(.reference-note p:last-child) {
    margin-bottom: 0;
  }

  .reference-body :global(.compare-table-wrapper) {
    margin: var(--space-8) 0;
    overflow-x: auto;
  }

  .reference-body :global(.compare-table) {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--text-base);
  }

  .reference-body :global(.compare-table th),
  .reference-body :global(.compare-table td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-bg-secondary);
    text-align: left;
    vertical-align: top;
  }

  .reference-body :global(.compare-table th) {
    color: var(--color-text-primary);
    background: var(--color-bg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .reference-body :global(.term-list) {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-8) 0 0;
  }

  .reference-body :global(.term-card) {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-bg-secondary);
    scroll-margin-top: 100px;
  }

  .reference-body :global(.term-card dt) {
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .reference-body :global(.term-hint) {
    margin-left: var(--space-2);
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .reference-body :global(.term-card dd) {
    margin: 0;
  }

  .reference-body :global(.term-card .interview-line) {
    margin-top: var(--space-3);
    margin-bottom: 0;
    color: var(--color-text-tertiary);
    font-size: var(--text-base);
    font-style: italic;
  }

  .reference-body :global(.source-section) {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-bg-secondary);
  }

  @media print {
    .reference-main {
      padding-top: 0;
    }

    .reference-hero,
    .reference-article {
      padding: var(--space-8) 0;
      background: none;
    }

    .breadcrumb {
      display: none;
    }

    .reference-body :global(.compare-table-wrapper) {
      overflow: visible;
    }

    .reference-body :global(.compare-table) {
      min-width: 0;
    }

    .reference-body :global(.term-card),
    .reference-body :global(.reference-note) {
      break-inside: avoid;
    }
  }
</style>
