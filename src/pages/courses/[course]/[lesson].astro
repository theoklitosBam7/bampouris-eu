---
import { type CollectionEntry, getCollection, render } from "astro:content";

import LessonPage from "@/layouts/LessonPage.astro";
import {
  getCourseReferenceCapabilities,
  getPublishedLessonsForCourse,
  validateLessonCatalog,
} from "@/utils/lessons";

type BlogPost = CollectionEntry<"blog">;
type Course = CollectionEntry<"courses">;
type CourseReference = CollectionEntry<"courseReferences">;
type Lesson = CollectionEntry<"lessons">;

type Props = {
  course: Course;
  lesson: Lesson;
  next?: Lesson;
  previous?: Lesson;
  referenceCapabilities: {
    "further-reading"?: CourseReference;
    glossary?: CourseReference;
  };
  relatedBlogPosts: BlogPost[];
};

export async function getStaticPaths() {
  const [courses, lessons, blogPosts, courseReferences] = await Promise.all([
    getCollection("courses"),
    getCollection("lessons"),
    getCollection("blog"),
    getCollection("courseReferences"),
  ]);
  validateLessonCatalog({ courseReferences, courses, lessons });

  return courses.flatMap((course) => {
    const publishedLessons = getPublishedLessonsForCourse(course, lessons);
    const referenceCapabilities = getCourseReferenceCapabilities(
      course.data.slug,
      courseReferences,
    );

    return publishedLessons.map((lesson, currentIndex) => ({
      params: {
        course: course.data.slug,
        lesson: lesson.data.slug,
      },
      props: {
        course,
        lesson,
        next: publishedLessons[currentIndex + 1],
        previous: publishedLessons[currentIndex - 1],
        referenceCapabilities,
        relatedBlogPosts: blogPosts.filter((post) =>
          post.data.relatedLessons?.some(
            (relatedLesson) =>
              relatedLesson.course === lesson.data.course &&
              relatedLesson.slug === lesson.data.slug,
          ),
        ),
      },
    }));
  });
}

const {
  course,
  lesson,
  next,
  previous,
  referenceCapabilities,
  relatedBlogPosts,
} = Astro.props;
const { Content } = await render(lesson);
---

<LessonPage
  course={course}
  lesson={lesson}
  next={next}
  previous={previous}
  referenceCapabilities={referenceCapabilities}
  relatedBlogPosts={relatedBlogPosts}
>
  <Content />
</LessonPage>
