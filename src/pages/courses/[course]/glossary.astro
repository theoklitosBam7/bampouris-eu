---
import { type CollectionEntry, getCollection, render } from "astro:content";

import LessonReferencePage from "@/layouts/LessonReferencePage.astro";
import { validateLessonCatalog } from "@/utils/lessons";

type Course = CollectionEntry<"courses">;
type CourseReference = CollectionEntry<"courseReferences">;

type Props = {
  course: Course;
  reference: CourseReference;
};

export async function getStaticPaths() {
  const [courses, lessons, courseReferences] = await Promise.all([
    getCollection("courses"),
    getCollection("lessons"),
    getCollection("courseReferences"),
  ]);
  validateLessonCatalog({ courseReferences, courses, lessons });

  const coursesBySlug = new Map(
    courses.map((course) => [course.data.slug, course]),
  );

  return courseReferences
    .filter((reference) => reference.data.kind === "glossary")
    .map((reference) => {
      const course = coursesBySlug.get(reference.data.course);

      if (!course) {
        throw new Error(
          `Glossary reference "${reference.id}" has no matching course.`,
        );
      }

      return {
        params: { course: course.data.slug },
        props: { course, reference },
      };
    });
}

const { course, reference } = Astro.props;
const { Content } = await render(reference);
---

<LessonReferencePage
  course={course}
  description={reference.data.description}
  eyebrow={reference.data.eyebrow}
  title={reference.data.title}
>
  <Content />
</LessonReferencePage>
