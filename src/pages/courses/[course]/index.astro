---
import { type CollectionEntry, getCollection, render } from "astro:content";

import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import LessonFilters from "@/components/lessons/LessonFilters.astro";
import SourceList from "@/components/lessons/SourceList.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";
import {
  formatDuration,
  formatStatus,
  getCourseReferenceCapabilities,
  getCourseReferencePath,
  getLessonPath,
  getOrderedLessonSummaries,
  getPublishedLessonsForCourse,
  validateLessonCatalog,
} from "@/utils/lessons";

type Props = {
  course: CollectionEntry<"courses">;
};

export async function getStaticPaths() {
  const [courses, lessons, courseReferences] = await Promise.all([
    getCollection("courses"),
    getCollection("lessons"),
    getCollection("courseReferences"),
  ]);
  validateLessonCatalog({ courseReferences, courses, lessons });

  return courses.map((course) => ({
    params: { course: course.data.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const { data } = course;
const [lessons, courseReferences] = await Promise.all([
  getCollection("lessons"),
  getCollection("courseReferences"),
]);
const publishedLessonsBySlug = new Map(
  getPublishedLessonsForCourse(course, lessons).map((lesson) => [
    lesson.data.slug,
    lesson,
  ]),
);
const referenceCapabilities = getCourseReferenceCapabilities(
  data.slug,
  courseReferences,
);
const orderedLessons = getOrderedLessonSummaries(course);
const lessonTopics = [
  ...new Set(orderedLessons.flatMap((lesson) => lesson.topics)),
].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      description={data.description}
      title={`${data.title} | Learning library`}
    />
  </head>
  <body class="grain-overlay">
    <Header />

    <main class="course-main">
      <header class="course-hero">
        <div class="container-narrow">
          <a class="breadcrumb" href="/courses/">
            <svg
              aria-hidden="true"
              fill="none"
              height="16"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="16"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            Learning library
          </a>

          <div class="course-kicker">
            <Tag size="sm" variant="accent">{formatStatus(data.status)}</Tag>
            <span>Course overview</span>
          </div>

          <h1 class="course-title">{data.title}</h1>
          <p class="course-description">{data.description}</p>

          <div class="course-actions">
            <Button href="#sequence" size="lg" variant="primary">
              View lesson sequence
            </Button>
            <Button href="/courses/" size="lg" variant="secondary">
              Browse all courses
            </Button>
          </div>
        </div>
      </header>

      <section aria-labelledby="overview-title" class="course-overview">
        <div class="container-wide">
          <div class="section-heading">
            <span class="section-label">Before you begin</span>
            <h2 id="overview-title">Course overview</h2>
          </div>

          <div class="overview-grid">
            <Card class="info-card" hover="none" padding="lg">
              <h3>At a glance</h3>
              <dl class="course-facts">
                <div>
                  <dt>Status</dt>
                  <dd>
                    <Tag size="sm" variant="accent"
                      >{formatStatus(data.status)}</Tag
                    >
                  </dd>
                </div>
                <div>
                  <dt>Published</dt>
                  <dd><FormattedDate date={data.publicationDate} /></dd>
                </div>
                <div>
                  <dt>Updated</dt>
                  <dd><FormattedDate date={data.updatedDate} /></dd>
                </div>
                <div>
                  <dt>Difficulty</dt>
                  <dd>{data.difficulty}</dd>
                </div>
                <div>
                  <dt>Duration</dt>
                  <dd>{formatDuration(data.durationMinutes)}</dd>
                </div>
                <div>
                  <dt>Planned lessons</dt>
                  <dd>{orderedLessons.length}</dd>
                </div>
              </dl>
            </Card>

            <Card class="info-card" hover="none" padding="lg">
              <h3>Prerequisites</h3>
              <ul class="check-list">
                {
                  data.prerequisites.map((prerequisite) => (
                    <li>{prerequisite}</li>
                  ))
                }
              </ul>
            </Card>
          </div>
        </div>
      </section>

      <section aria-labelledby="purpose-title" class="course-purpose">
        <div class="container-narrow">
          <div class="section-heading">
            <span class="section-label">Purpose</span>
            <h2 id="purpose-title">What you will be able to do</h2>
          </div>

          <div class="course-prose">
            <Content />
          </div>

          <ul class="objective-list">
            {
              data.objectives.map((objective, index) => (
                <li>
                  <span aria-hidden="true" class="objective-number">
                    {index + 1}
                  </span>
                  <span>{objective}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section aria-labelledby="scope-title" class="scope-section">
        <div class="container-wide">
          <Card class="scope-card" hover="none" padding="lg">
            <div class="scope-header">
              <div>
                <span class="section-label">Pilot scope</span>
                <h2 id="scope-title">What this pilot includes</h2>
              </div>
              <Tag size="md" variant="outline">{data.difficulty}</Tag>
            </div>

            <div class="scope-grid">
              <div>
                <h3>Included</h3>
                <ul class="check-list">
                  {data.pilotScope.included.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <h3>Not included yet</h3>
                <ul class="check-list muted-list">
                  {data.pilotScope.excluded.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </Card>
        </div>
      </section>

      <section
        aria-labelledby="sequence-title"
        class="sequence-section"
        id="sequence"
      >
        <div class="container-wide">
          <div class="section-heading sequence-heading">
            <div>
              <span class="section-label">Lessons</span>
              <h2 id="sequence-title">Lesson sequence</h2>
            </div>
            <p>
              Take the lessons in order. Published lessons link to their pages;
              planned lessons are listed below.
            </p>
          </div>

          <LessonFilters indexId="courseLessonIndex" topics={lessonTopics} />

          <ol class="lesson-list" id="courseLessonIndex">
            {
              orderedLessons.map((lesson) => {
                const publishedLesson = publishedLessonsBySlug.get(lesson.slug);

                return (
                  <li
                    class={`lesson-card ${lesson.status === "published" ? "is-published" : "is-planned"}`}
                    data-difficulty={lesson.difficulty}
                    data-lesson-item
                    data-topics={lesson.topics.join(",")}
                  >
                    <div aria-hidden="true" class="lesson-number">
                      {String(lesson.lessonNumber).padStart(4, "0")}
                    </div>
                    <div class="lesson-content">
                      <div class="lesson-heading">
                        <h3>{lesson.title}</h3>
                        <Tag
                          size="sm"
                          variant={
                            lesson.status === "published" ? "accent" : "outline"
                          }
                        >
                          {lesson.status === "published"
                            ? "Published"
                            : "Planned"}
                        </Tag>
                      </div>
                      <p>{lesson.description}</p>
                      <div class="lesson-details">
                        <span>{formatDuration(lesson.durationMinutes)}</span>
                        <span>{lesson.difficulty}</span>
                        {lesson.topics.map((topic) => (
                          <span>{topic}</span>
                        ))}
                      </div>
                      {publishedLesson ? (
                        <a
                          class="lesson-link"
                          href={getLessonPath(
                            data.slug,
                            publishedLesson.data.slug,
                          )}
                        >
                          Open lesson
                          <svg
                            aria-hidden="true"
                            fill="none"
                            height="16"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                            width="16"
                          >
                            <path d="M5 12h14" />
                            <path d="m12 5 7 7-7 7" />
                          </svg>
                        </a>
                      ) : (
                        <span class="lesson-unavailable">Not published</span>
                      )}
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </div>
      </section>

      <section aria-labelledby="sources-title" class="details-section">
        <div class="container-wide">
          <Card class="details-card" hover="none" padding="lg">
            <div aria-label="Course references" class="course-reference-links">
              {
                referenceCapabilities.glossary && (
                  <a href={getCourseReferencePath(data.slug, "glossary")}>
                    Course glossary
                  </a>
                )
              }
              {
                referenceCapabilities["further-reading"] && (
                  <a
                    href={getCourseReferencePath(data.slug, "further-reading")}
                  >
                    Further reading
                  </a>
                )
              }
            </div>
            <h2 id="sources-title">Course sources</h2>
            <SourceList class="source-list" sources={data.sources} />
          </Card>

          <p class="ai-disclosure">
            <strong>AI assistance:</strong>
            {data.aiAssistanceDisclosure}
          </p>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .course-main {
    padding-top: 80px;
  }

  .course-hero {
    padding: var(--space-12) 0 var(--space-16);
    background:
      radial-gradient(
        circle at 80% 20%,
        rgba(37, 99, 235, 0.12),
        transparent 35%
      ),
      var(--color-bg-primary);
  }

  .breadcrumb,
  .lesson-link,
  :global(.source-list a) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    text-decoration: none;
  }

  .breadcrumb {
    margin-bottom: var(--space-10);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .breadcrumb:hover,
  .lesson-link:hover,
  :global(.source-list a):hover {
    color: var(--accent-dark);
  }

  .course-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .course-title {
    max-width: 820px;
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .course-title {
      font-size: var(--text-6xl);
    }
  }

  .course-description {
    max-width: 760px;
    margin-bottom: var(--space-8);
    font-size: var(--text-xl);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .course-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .course-overview,
  .course-purpose,
  .scope-section,
  .sequence-section,
  .details-section {
    padding: var(--space-16) 0;
  }

  .course-overview,
  .sequence-section,
  .details-section {
    background: var(--color-bg-secondary);
  }

  .section-heading {
    margin-bottom: var(--space-8);
  }

  .section-heading h2,
  .scope-header h2,
  .details-card h2 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .section-heading p {
    max-width: 440px;
    margin: var(--space-4) 0 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .overview-grid,
  .scope-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .overview-grid,
    .scope-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .info-card,
  .scope-card,
  .details-card {
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  @media (prefers-color-scheme: dark) {
    .info-card,
    .scope-card,
    .details-card {
      border-color: rgba(255, 255, 255, 0.05);
    }
  }

  .info-card h3,
  .scope-grid h3 {
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .course-facts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .course-facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-bg-secondary);
  }

  .course-facts div:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .course-facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .course-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: right;
    color: var(--color-text-primary);
  }

  .check-list,
  :global(.source-list) {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .check-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .check-list li::before {
    position: absolute;
    top: 0.45em;
    left: 0;
    width: 0.7em;
    height: 0.7em;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    content: "";
  }

  .course-purpose {
    background: var(--color-bg-primary);
  }

  .course-prose {
    margin-bottom: var(--space-8);
  }

  .course-prose :global(p) {
    margin: 0 0 var(--space-5);
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .course-prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .objective-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .objective-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .objective-number {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: rgba(37, 99, 235, 0.1);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .scope-section {
    background: var(--color-bg-primary);
  }

  .scope-card {
    background: linear-gradient(
      135deg,
      var(--color-bg-primary),
      rgba(37, 99, 235, 0.05)
    );
  }

  .scope-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .scope-header h2 {
    margin-bottom: 0;
  }

  .scope-grid h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .muted-list li::before {
    border-color: var(--color-text-tertiary);
  }

  .sequence-section {
    scroll-margin-top: 80px;
  }

  .sequence-heading {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .sequence-heading {
      grid-template-columns: 1fr 400px;
      align-items: end;
      justify-content: space-between;
    }
  }

  .lesson-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: lessons;
  }

  .lesson-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-bg-primary);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 640px) {
    .lesson-card {
      gap: var(--space-6);
      padding: var(--space-6);
    }
  }

  @media (prefers-color-scheme: dark) {
    .lesson-card {
      border-color: rgba(255, 255, 255, 0.05);
    }
  }

  .lesson-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .is-published .lesson-number {
    background: rgba(37, 99, 235, 0.1);
    color: var(--color-accent);
  }

  .lesson-content {
    min-width: 0;
  }

  .lesson-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .lesson-heading h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .lesson-content p {
    margin: 0 0 var(--space-4);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .lesson-details {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .lesson-details span:not(:last-child)::after {
    margin-left: var(--space-4);
    content: "·";
    color: var(--color-text-tertiary);
  }

  .lesson-link,
  .lesson-unavailable {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .lesson-link svg {
    transition: transform var(--transition-fast);
  }

  .lesson-link:hover svg {
    transform: translateX(3px);
  }

  .lesson-unavailable {
    color: var(--color-text-tertiary);
  }

  .details-section {
    padding-bottom: var(--space-10);
  }

  .details-card h2 {
    margin-bottom: var(--space-6);
    font-size: var(--text-2xl);
  }

  .course-reference-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-bg-secondary);
  }

  .course-reference-links a {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .course-reference-links a:hover {
    color: var(--accent-dark);
  }

  :global(.source-list a) {
    font-size: var(--text-base);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  :global(.source-list a) svg {
    flex: 0 0 auto;
  }

  .ai-disclosure {
    max-width: 800px;
    margin: var(--space-8) auto 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    text-align: center;
    color: var(--color-text-tertiary);
  }

  .ai-disclosure strong {
    color: var(--color-text-secondary);
  }

  @media (max-width: 639px) {
    .lesson-heading {
      flex-direction: column;
      align-items: flex-start;
    }

    .scope-header {
      flex-direction: column;
    }
  }

  @media print {
    .course-main {
      padding-top: 0;
    }

    .course-hero {
      padding: var(--space-8) 0;
      background: none;
    }

    .course-actions,
    .breadcrumb {
      display: none;
    }

    .course-overview,
    .course-purpose,
    .scope-section,
    .sequence-section,
    .details-section {
      padding: var(--space-8) 0;
      background: none;
    }

    .info-card,
    .scope-card,
    .details-card,
    .lesson-card {
      break-inside: avoid;
      box-shadow: none;
    }
  }
</style>
